# Copy to backend/.env before starting the API.
# Placeholder values only. Never commit a real secret.

DATABASE_URL=sqlite:///./heartbridge.db
# For Vercel, set DATABASE_URL in the project settings to a Neon PostgreSQL URL with sslmode=require.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://heart-bridge-flame.vercel.app
ALLOW_LOCALHOST_ORIGIN=true
DEMO_BANNER=true
RATE_LIMIT_ENABLED=true

# Gemini is preferred when configured. Leave both provider keys blank for labelled demo replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional existing OpenAI-compatible provider fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1200
AI_STREAM_DELAY=0.012

UPLOAD_DIR=uploads
